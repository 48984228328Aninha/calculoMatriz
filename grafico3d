import numpy as np
import matplotlib.pyplot as plt

X = np.arrange(-np.pi, np.pi, 0.5)
Y = np.arrange(-np.pi, np.pi, 0.5)

#Bidimensional
X, Y = np.meshgrid(X, Y)
f_xy = np.sqrt(X ** 2 + Y ** 2)

#Tridimensional
Z = np.cos(f_xy)
fig, ax = plt.subplots(subplot_kw={'projection': '3d'})
ax.plot_surface(X, Y, Z, cmap='cool')
plt.show()